rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== CAMBIA ESTE CORREO por el del administrador inicial ======
    // Debe ser el mismo que kAdminInicial en lib/config.dart (en minúsculas).
    function adminInicial() {
      return request.auth.token.email == 'efrospizza@gmail.com';
    }

    function conCuenta() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function perfilDe(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    // Tiene ese rol Y la cuenta no está suspendida.
    function tieneRol(r) {
      return conCuenta()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && perfilDe(request.auth.uid).rol == r
        && perfilDe(request.auth.uid).activo != false;
    }
    function esAdmin() { return tieneRol('admin'); }
    function esProveedor() { return tieneRol('proveedor'); }
    function esNegocio() { return tieneRol('negocio'); }
    // Cualquier cuenta activa de proveedor, negocio o administrador.
    function cuentaActiva() {
      return conCuenta()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && perfilDe(request.auth.uid).activo != false;
    }
    function vinculoActivo(proveedorId, negocioId) {
      return exists(/databases/$(database)/documents/vinculos/$(proveedorId + '_' + negocioId))
        && get(/databases/$(database)/documents/vinculos/$(proveedorId + '_' + negocioId)).data.estado == 'activo';
    }

    // ---------- Cuentas ----------
    match /users/{uid} {
      allow read: if conCuenta() && (request.auth.uid == uid || esAdmin());
      // Cada quien se crea como proveedor o negocio. Solo el correo del
      // administrador inicial puede crearse como admin.
      allow create: if conCuenta() && request.auth.uid == uid
        && request.resource.data.rolBase in ['proveedor', 'negocio']
        && (request.resource.data.rol == request.resource.data.rolBase
            || (request.resource.data.rol == 'admin' && adminInicial()))
        && request.resource.data.verificado == false
        && request.resource.data.activo == true
        && request.resource.data.codigo == '';
      // Se puede editar el propio perfil, pero no rol, verificación,
      // suspensión ni el código (que solo se asigna una vez).
      allow update: if esAdmin() || (
        conCuenta() && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.rolBase == resource.data.rolBase
        && request.resource.data.verificado == resource.data.verificado
        && request.resource.data.activo == resource.data.activo
        && (request.resource.data.codigo == resource.data.codigo
            || resource.data.codigo == ''));
      allow delete: if esAdmin();
    }

    // ---------- Ficha pública de proveedores (el id es su código) ----------
    match /directorio/{codigo} {
      allow read: if cuentaActiva();
      allow create: if esProveedor()
        && request.resource.data.proveedorId == request.auth.uid
        && request.resource.data.verificado == false
        && request.resource.data.activo == true;
      allow update: if esAdmin() || (
        esProveedor() && resource.data.proveedorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['empresa', 'giro', 'telefono']));
      allow delete: if esAdmin();
    }

    // ---------- Catálogo del proveedor ----------
    match /catalogo/{id} {
      allow read: if cuentaActiva();
      allow create: if esProveedor()
        && request.resource.data.proveedorId == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.precio is number
        && request.resource.data.precio >= 0;
      allow update: if esProveedor()
        && resource.data.proveedorId == request.auth.uid
        && request.resource.data.proveedorId == request.auth.uid
        && request.resource.data.precio is number
        && request.resource.data.precio >= 0;
      allow delete: if esProveedor() && resource.data.proveedorId == request.auth.uid;
    }

    // Datos para transferencia: solo el dueño y sus clientes vinculados.
    match /cobros/{proveedorId} {
      allow read: if esAdmin()
        || (esProveedor() && request.auth.uid == proveedorId)
        || (esNegocio() && vinculoActivo(proveedorId, request.auth.uid));
      allow write: if esProveedor() && request.auth.uid == proveedorId;
    }

    // ---------- Relación proveedor <-> negocio (id: proveedorId_negocioId) ----------
    match /vinculos/{id} {
      allow read: if esAdmin()
        || (conCuenta() && (resource.data.proveedorId == request.auth.uid
                            || resource.data.negocioId == request.auth.uid));
      // El negocio solicita con el código del proveedor...
      allow create: if esNegocio()
        && request.resource.data.negocioId == request.auth.uid
        && id == request.resource.data.proveedorId + '_' + request.auth.uid
        && request.resource.data.estado == 'pendiente';
      // ...o se vincula solo si el proveedor lo registró con su correo.
      allow create: if esNegocio()
        && request.resource.data.negocioId == request.auth.uid
        && id == request.resource.data.proveedorId + '_' + request.auth.uid
        && request.resource.data.estado == 'activo'
        && exists(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacionId))
        && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacionId)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacionId)).data.proveedorId == request.resource.data.proveedorId
        && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacionId)).data.estado == 'pendiente';
      // El proveedor aprueba, rechaza, desactiva y anota.
      allow update: if esProveedor() && resource.data.proveedorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'notas']);
      allow delete: if esAdmin()
        || (esNegocio() && resource.data.negocioId == request.auth.uid
            && resource.data.estado in ['pendiente', 'rechazado']);
    }

    // Negocios que el proveedor registró por correo (aún sin vincular).
    match /invitaciones/{id} {
      allow read: if esAdmin()
        || (conCuenta() && (resource.data.proveedorId == request.auth.uid
                            || resource.data.email == request.auth.token.email));
      allow create: if esProveedor()
        && request.resource.data.proveedorId == request.auth.uid
        && request.resource.data.estado == 'pendiente';
      allow update: if (esProveedor() && resource.data.proveedorId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['nombre', 'contacto', 'telefono', 'direccion', 'notas']))
        || (esNegocio() && resource.data.email == request.auth.token.email
            && request.resource.data.estado == 'aceptada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']));
      allow delete: if esProveedor() && resource.data.proveedorId == request.auth.uid;
    }

    // ---------- Pedidos ----------
    match /pedidos/{id} {
      allow read: if esAdmin()
        || (conCuenta() && (resource.data.proveedorId == request.auth.uid
                            || resource.data.negocioId == request.auth.uid));
      // Solo un negocio con relación ACTIVA puede pedirle a ese proveedor.
      allow create: if esNegocio()
        && request.resource.data.negocioId == request.auth.uid
        && vinculoActivo(request.resource.data.proveedorId, request.auth.uid)
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow update:
        // El proveedor avanza el estado.
        if (esProveedor() && resource.data.proveedorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado']))
        // El negocio cancela mientras sigue "nuevo"...
        || (esNegocio() && resource.data.negocioId == request.auth.uid
            && resource.data.estado == 'nuevo'
            && request.resource.data.estado == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado']))
        // ...adjunta comprobante, o marca que ya sumó el pedido al inventario.
        || (esNegocio() && resource.data.negocioId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['tieneComprobante']))
        || (esNegocio() && resource.data.negocioId == request.auth.uid
            && resource.data.estado == 'entregado'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['inventarioActualizado']));
      allow delete: if esAdmin();
    }

    // Fotos de comprobantes (aparte para no cargar el listado de pedidos).
    match /comprobantes/{id} {
      allow read: if esAdmin()
        || (conCuenta() && (resource.data.proveedorId == request.auth.uid
                            || resource.data.negocioId == request.auth.uid));
      allow create: if esNegocio()
        && request.resource.data.negocioId == request.auth.uid;
      allow update: if esNegocio()
        && resource.data.negocioId == request.auth.uid
        && request.resource.data.negocioId == request.auth.uid;
      allow delete: if esAdmin();
    }

    // ---------- Abonos (los registra el proveedor) ----------
    match /abonos/{id} {
      allow read: if esAdmin()
        || (conCuenta() && (resource.data.proveedorId == request.auth.uid
                            || resource.data.negocioId == request.auth.uid));
      allow create: if esProveedor()
        && request.resource.data.proveedorId == request.auth.uid
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && vinculoActivo(request.auth.uid, request.resource.data.negocioId);
      allow delete: if esProveedor() && resource.data.proveedorId == request.auth.uid;
    }

    // ---------- Inventario: privado de cada negocio ----------
    match /negocios/{uid}/productos/{id} {
      allow read, delete: if esNegocio() && request.auth.uid == uid;
      allow create, update: if esNegocio() && request.auth.uid == uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad >= 0
        && request.resource.data.stockMinimo is number
        && request.resource.data.stockMinimo >= 0;
    }
    match /negocios/{uid}/movimientos/{id} {
      allow read, create: if esNegocio() && request.auth.uid == uid;
      allow update, delete: if false;
    }
  }
}
